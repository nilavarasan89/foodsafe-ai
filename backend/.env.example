PROJECT_NAME="FOODSAFE AI"
API_V1_STR="/api"
SECRET_KEY="foodsafe-ai-super-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database - SQLite by default for easy local execution, supports PostgreSQL
DATABASE_URL="sqlite:///./foodsafe.db"
# Example PostgreSQL: postgresql://user:password@localhost:5432/foodsafe_db

# ML Service Settings
ML_MODE="mock" # "mock" or "real"
REAL_ML_ENDPOINT="http://localhost:9000/predict"

# Hardware / RPi Settings
SIMULATOR_SPEED_MS=2000
DEMO_MODE_DEFAULT=true

# Decision Engine Configurable Thresholds (Demo defaults)
NORMAL_CONFIDENCE_THRESHOLD=0.90
SUSPICIOUS_CONFIDENCE_THRESHOLD=0.70
